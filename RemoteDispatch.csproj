<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>8.0</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>DvMod.RemoteDispatch</RootNamespace>
		<InformationalVersion>1.4.1</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" Version="2.2.1" />
		<Publicize Include="Assembly-CSharp" IncludeCompilerGeneratedMembers="false" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp" />
		<Reference Include="DV.BrakeSystem" />
		<Reference Include="DV.Simulation" />
		<Reference Include="DV.Common" />
		<Reference Include="DV.Interaction" />
		<Reference Include="DV.PointSet" />
		<Reference Include="DV.RailTrack" />
		<Reference Include="DV.ThingTypes" />
		<Reference Include="DV.Utils" />
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="Newtonsoft.Json" />
		<Reference Include="net.smkd.vector3d" />
		<Reference Include="WorldStreamer" />
		<Reference Include="Facepunch.Steamworks.Win64" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="UnityEngine.CoreModule" />
		<Reference Include="UnityEngine.IMGUIModule" />
		<PackageReference Include="UnityModManager" Version="0.27.2" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="frontend/icon.svg" />
		<EmbeddedResource Include="frontend/index.html" />
		<EmbeddedResource Include="frontend/*.js" />
		<EmbeddedResource Include="frontend/style.css" />
		<EmbeddedResource Include="licenses/*.png" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- Copy to build folder -->
		<Copy SourceFiles="$(TargetPath)" DestinationFolder=".\build\" />

		<!-- Test deploy after debug build -->
		<Exec Condition="'$(ConfigurationName)' != 'Release' And '$(OS)' == 'Windows_NT'" Command="powershell -executionpolicy bypass .\package.ps1 -NoArchive -OutputDirectory &quot;'C:\Program Files\Steam\steamapps\common\Derail Valley\Mods'&quot;" />

		<!-- Package after Release build -->
		<Exec Condition="'$(ConfigurationName)' == 'Release' And '$(OS)' == 'Windows_NT'" Command="powershell -executionpolicy bypass -Command &quot;(.\package.ps1)&quot;" />
	</Target>
</Project>
